# ============================================================
# RAG Finance AI Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ============================================================

# Google Gemini API Key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# ChromaDB persistent directory (optional; defaults to ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name (optional)
CHROMA_COLLECTION_NAME=finance-rag-chatbot
